# ===========================================
# CampusPulse Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
DATABASE_URL=postgresql://campuspulse:campuspulse@localhost:5432/campuspulse
POSTGRES_USER=campuspulse
POSTGRES_PASSWORD=campuspulse
POSTGRES_DB=campuspulse
POSTGRES_PORT=5432

# -------------------------------------------
# API (NestJS)
# -------------------------------------------
API_PORT=4000
API_PREFIX=api

# -------------------------------------------
# Web (Next.js)
# -------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# -------------------------------------------
# Auth (Phase 4 — JWT Authentication)
# -------------------------------------------
JWT_SECRET=change-this-in-development
JWT_EXPIRES_IN=7d
JWT_EXPIRATION=7d

# -------------------------------------------
# Environment
# -------------------------------------------
NODE_ENV=development
