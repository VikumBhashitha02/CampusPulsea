{
  "name": "campuspulse",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "pnpm --filter @campuspulse/database db:generate",
    "db:migrate": "pnpm --filter @campuspulse/database db:migrate",
    "db:push": "pnpm --filter @campuspulse/database db:push",
    "db:studio": "pnpm --filter @campuspulse/database db:studio",
    "db:seed": "pnpm --filter @campuspulse/database db:seed"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
